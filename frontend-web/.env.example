# ═══════════════════════════════════════════════════════════════════════════════
#  Wealth Platform — Variables de entorno para Vercel
#  Copia este fichero, rellena los valores y pégalos en:
#    Vercel Dashboard → Project → Settings → Environment Variables
#
#  Prefijo NEXT_PUBLIC_* → accesibles en el browser (bundle del cliente).
#  Sin prefijo          → solo en el servidor (API Routes, Server Components).
#
#  ⚠ NUNCA pongas claves secretas en variables NEXT_PUBLIC_*: son públicas.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Módulo 1, 2, 3 y 4 — Backend Java (backend-core-java) ──────────────────
#
#  URL base de la API REST del backend Java.
#  Incluye el prefijo /api/v1 (el backend lo declara en application.yml).
#  En producción: la URL pública del backend desplegado (Railway, Fly.io, etc.)
#  En local:      http://localhost:8080/api/v1
#
NEXT_PUBLIC_API_BASE_URL=https://your-java-backend.example.com/api/v1

# ─── Módulo 3 y 4 — Servicio Python de IA (ai-and-ingest-python / Claude) ───
#
#  URL base del servicio FastAPI de Python que llama a Claude.
#  Usado por:
#    - irpfService.ts → POST /explain/irpf-sale | POST /explain/irpf-annual
#    - pledgeService.ts → GET /contracts/pledge-sample | POST /extract/pledge-contract
#                       → POST /explain/pledge-status
#  En producción: la URL pública del servicio Python desplegado.
#  En local:      http://localhost:8000
#
NEXT_PUBLIC_AI_BASE_URL=https://your-python-ai-service.example.com

# ─── Modo mock (desarrollo sin backend) ─────────────────────────────────────
#
#  true  → Usa custody_positions.json (incluido en el bundle) como fuente de
#           datos en lugar de llamar al backend Java. Las acciones de escritura
#           (Rebalancear, Editar meta, Aportación) se desactivan automáticamente.
#           Las llamadas al servicio Python siguen fallando gracilmente.
#  false → Usa el backend real (NEXT_PUBLIC_API_BASE_URL). Valor para producción.
#
NEXT_PUBLIC_USE_MOCK=false
