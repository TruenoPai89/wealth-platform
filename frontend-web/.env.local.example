# Copia este fichero a .env.local (ignorado por git) y ajusta si hace falta.
# Para producción en Vercel, consulta .env.example y configura las variables
# en el panel: Settings → Environment Variables.

# Base URL de la API REST del backend Java (incluye /api/v1).
# El backend core escucha en 8080 localmente.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# true = usar src/core-ui/mocks/custody_positions.json en lugar del backend Java.
# Útil para trabajar en la UI sin backend arrancado. No activa el servicio Python.
NEXT_PUBLIC_USE_MOCK=false

# Servicio Python (FastAPI + Claude). Módulos 3 (IRPF) y 4 (Pignoración).
# Escucha en 8000 localmente (uvicorn main:app --port 8000 en ai-and-ingest-python/).
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000