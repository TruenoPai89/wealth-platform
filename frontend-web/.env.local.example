# Copia este fichero a .env.local (ignorado por git) y ajusta si hace falta.

# Base URL de la API REST del backend Java (incluye /api/v1). El backend core escucha en 8080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# true = usar bank-simulator-mocks/custody_positions.json en lugar del backend.
NEXT_PUBLIC_USE_MOCK=false
